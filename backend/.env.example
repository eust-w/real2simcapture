REAL2SIM_DATABASE_URL=sqlite:///data/real2sim.sqlite3
REAL2SIM_DATABASE_CONNECT_TIMEOUT_SECONDS=3
REAL2SIM_DATA_DIR=data
REAL2SIM_OUTPUT_DIR=outputs
REAL2SIM_PUBLIC_BASE_URL=http://127.0.0.1:8000
REAL2SIM_DEFAULT_DENSITY_KG_M3=700
REAL2SIM_DEFAULT_FRICTION=0.6
REAL2SIM_CAPTURE_MIN_FRAMES=12
REAL2SIM_CAPTURE_MIN_USABLE_FRAMES=8
REAL2SIM_CAPTURE_BLUR_VARIANCE_THRESHOLD=100
REAL2SIM_CAPTURE_MIN_EXPOSURE_MEAN=25
REAL2SIM_CAPTURE_MAX_EXPOSURE_MEAN=230
REAL2SIM_CAPTURE_MAX_CLIPPED_RATIO=0.25
REAL2SIM_CAPTURE_MIN_COVERAGE_DEGREES=120
REAL2SIM_CAPTURE_REQUIRE_SCALE_REFERENCE=false
REAL2SIM_RECONSTRUCTION_PROVIDER=colmap
# Fallback providers:
# REAL2SIM_RECONSTRUCTION_PROVIDER=kiri_featureless
# REAL2SIM_KIRI_API_KEY=change-me
# If REAL2SIM_KIRI_API_KEY is unset, the backend also checks macOS Keychain services
# REAL2SIM_KIRI_API_KEY, KIRI_API_KEY, and KIRI_ENGINE_API_KEY without logging the secret.
# Store/check without printing the key:
# printf '%s' '<api-key>' | .venv/bin/python scripts/kiri_credentials.py --store-keychain --check
# REAL2SIM_KIRI_BASE_URL=https://api.kiriengine.app/api/v1/open
# REAL2SIM_KIRI_FILE_FORMAT=OBJ
# REAL2SIM_KIRI_HEALTH_TIMEOUT_SECONDS=15
# REAL2SIM_RECONSTRUCTION_PROVIDER=apple_object_capture
# Default Apple Object Capture command uses scripts/apple_object_capture.py:
# RealityKit PhotogrammetrySession -> USDZ -> Blender OBJ conversion.
# REAL2SIM_APPLE_OBJECT_CAPTURE_COMMAND=/path/to/object-capture-cli '{images_dir}' '{output_mesh}'
# REAL2SIM_APPLE_OBJECT_CAPTURE_DETAIL=medium
REAL2SIM_SEGMENTATION_PROVIDER=rgbd_masks
# REAL2SIM_SEGMENTATION_PROVIDER=sam2
# Supported SAM2 placeholders: {capture_dir}, {images_dir}, {video_path}, {depth_dir}, {intrinsics_path}, {poses_path}, {objects_path}, {surfaces_path}, {output_masks_dir}
# Default SAM2 command uses scripts/sam2_generate_masks.py and facebook/sam2.1-hiera-tiny.
# REAL2SIM_SAM2_COMMAND=/path/to/sam2-runner --images '{images_dir}' --video '{video_path}' --output-masks '{output_masks_dir}'
# REAL2SIM_SAM2_MODEL_ID=facebook/sam2.1-hiera-tiny
# REAL2SIM_SAM2_CHECKPOINT=/path/to/sam2_checkpoint.pt
# REAL2SIM_SAM2_MODEL_CFG=/path/to/sam2_config.yaml
REAL2SIM_SIMULATOR_VALIDATION_TIMEOUT_SECONDS=300
# Native simulator import validators. Each command is executed by POST /api/tasks/<id>/verify-simulation.
# Supported placeholders: {simulator}, {package_dir}, {mjcf_path}, {urdf_path}, {usd_path}, {usdz_path}, {manifest_path}, {scene_json_path}, {zip_path}
# Set REAL2MOTRIX_DIR to a separately installed Real2Motrix checkout to enable its validator.
# If REAL2SIM_MOTRIXSIM_SSH_COMMAND is set, MotrixSim defaults to scripts/motrixsim_ssh_validate.py,
# uploads the package to the remote host, and runs motrixsim.load_model('scene.xml') there.
# If REAL2SIM_ISAACSIM_PYTHON or ISAACSIM_PYTHON points to a real Isaac Sim Python,
# Isaac Sim defaults to scripts/isaacsim_validate.py and opens scene.usd in headless SimulationApp.
# If REAL2SIM_ISAACSIM_SSH_TARGET is set, Isaac Sim defaults to scripts/isaacsim_ssh_validate.py,
# uploads the package to the remote host, and runs the same headless validator there.
# REAL2SIM_MOTRIXSIM_VALIDATE_COMMAND=/path/to/motrixsim-validator '{mjcf_path}'
# REAL2SIM_MOTRIXSIM_SSH_COMMAND=ssh -i /path/to/key -p 22 user@linux-motrix-host
# REAL2SIM_MOTRIXSIM_REMOTE_PYTHON=/opt/motrixlab/venv/bin/python
# REAL2SIM_MOTRIXSIM_REMOTE_REPO=/opt/motrixlab/repo
# REAL2SIM_ISAACSIM_VALIDATE_COMMAND=/path/to/isaacsim-validator '{usd_path}'
# REAL2SIM_ISAACSIM_PYTHON=/path/to/isaac-sim/python.sh
# Prefer this when the SSH connection needs identity files, ports, jump hosts, or options:
# REAL2SIM_ISAACSIM_SSH_COMMAND=ssh -i /path/to/key -p 22 user@linux-isaac-host
# REAL2SIM_ISAACSIM_SSH_TARGET=user@linux-isaac-host
# REAL2SIM_ISAACSIM_REMOTE_PYTHON=/path/to/isaac-sim/python.sh
# REAL2SIM_ISAACSIM_REMOTE_ROOT=/tmp/real2sim-isaacsim
# REAL2SIM_GENESIS_VALIDATE_COMMAND=/path/to/genesis-validator '{manifest_path}' '{package_dir}'
REAL2SIM_QUEUE_BACKEND=local
REAL2SIM_REDIS_URL=redis://127.0.0.1:6379/0
REAL2SIM_REDIS_QUEUE_NAME=real2sim:tasks
REAL2SIM_STORAGE_BACKEND=local
REAL2SIM_STORAGE_DIR=artifacts
# For Postgres production state:
# REAL2SIM_DATABASE_URL=postgresql://real2sim:change-me@127.0.0.1:5432/real2sim
# For S3/MinIO artifact publishing:
# REAL2SIM_STORAGE_BACKEND=s3
# REAL2SIM_S3_ENDPOINT_URL=http://127.0.0.1:9000
# REAL2SIM_S3_BUCKET=real2sim-artifacts
# REAL2SIM_S3_ACCESS_KEY_ID=change-me
# REAL2SIM_S3_SECRET_ACCESS_KEY=change-me
# REAL2SIM_S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/real2sim-artifacts
